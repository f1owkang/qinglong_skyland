# 必填：token 列表（逗号分隔）
SKYLAND_TOKENS=

# 可选：失败时退出 on/off（默认 off）
EXIT_WHEN_FAIL=off

# 可选：是否使用代理 on/off（默认 off）
USE_PROXY=off

# 可选：通知标题
NOTIFY_TITLE=森空岛自动签到

# ===== Hermes 模式（可选）=====
# 运行模式：auto（默认，同目录有 notify.py 则青龙模式）/ qinglong / hermes
SKYLAND_MODE=auto

# Hermes 模式下可选的 token 文件（每行一个 token，# 开头为注释）
# 与 SKYLAND_TOKENS 合并去重；不设则只用环境变量
SKYLAND_TOKEN_FILE=~/.config/skyland/tokens

# Hermes 模式：全部签到成功时静默（stdout 不输出，定时任务不投递消息）on/off（默认 off）
SKYLAND_SILENT_OK=off
